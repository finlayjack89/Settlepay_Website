---
/**
 * StickyCta — the mobile enquiry panel that rises from the bottom of the screen.
 *
 * Two deliberate properties, both asked for directly:
 * 1. CONTEXTUAL — it appears only while a value-demonstrating section is on
 *    screen (Our Work, the comparison matrix, the ROI calculator), and stands
 *    aside for the hero, the final CTA band and the footer. SiteScripts drives
 *    this with an IntersectionObserver.
 * 2. COMPACT — one action plus one reassurance line, and nothing else. It fills
 *    the width and reaches the bottom of the layout viewport; it does not earn
 *    height by stacking copy.
 *
 * Opaque rather than frosted on purpose: a solid surface is what reads as
 * "filled", and it dodges the iOS backdrop-filter clipping quirks. On the
 * unreachable strip below the layout viewport, see the note in the CSS.
 */
import { SITE } from '../data/site.mjs';
import Button from './Button.astro';
---
<div class="sticky-cta" data-sticky-cta>
  <div class="sticky-cta__panel">
    <Button variant="primary" size="large" icon="arrow" enquire data-enquire-source="sticky-cta">
      {SITE.cta.primary.label}
    </Button>
    <p class="sticky-cta__note">Free and no obligation — a reply within one working day.</p>
  </div>
</div>
<div class="sticky-cta-skirt" data-sticky-skirt aria-hidden="true"></div>

<style>
  /* The panel and the skirt are two elements pretending to be one surface, so
     they must slide as one: any difference in distance, duration or curve shows
     up as the seam between them drifting apart mid-animation. One shared
     distance, one shared transition, declared once here.
     --sticky-slide is re-set from the panel's measured height in SiteScripts;
     this value is only the pre-JS fallback. */
  .sticky-cta,
  .sticky-cta-skirt {
    --sticky-slide: 240px;
  }

  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90; /* below the nav (100) and the modal overlay (1000) */
    display: none; /* desktop: never */
    background: var(--color-pure-white);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    /* env() needs an explicit fallback — without one the whole calc() is
       invalidated on engines that don't support it. */
    padding: 1.15rem 1.25rem calc(1.15rem + env(safe-area-inset-bottom, 0px));
    box-shadow:
      0 -1px 0 rgba(15, 23, 42, 0.05),
      0 -18px 48px rgba(15, 23, 42, 0.16);
    /* Off-screen + non-focusable until shown; visibility flips after the slide. */
    transform: translateY(var(--sticky-slide));
    visibility: hidden;
    transition:
      transform 420ms var(--curve-spring),
      visibility 0s linear 420ms;
  }

  /* The skirt — what makes the panel reach the bottom of the screen on iOS.
     Safari anchors `bottom: 0` to the layout viewport and then keeps painting
     the scrolling document in the ~35px band below it, behind the floating
     toolbar; that band is the "gap under the bar". Every position:fixed layer
     is hard-clipped at the anchor, so the panel itself can never cover it —
     measured against a same-frame control on an iPhone 17 Pro Max / iOS 26,
     a fixed box stops at layout 795.7 while an absolutely positioned one
     paints on to 831.3. The skirt is therefore document content (absolute,
     scroll-synced in SiteScripts), which is exactly how an ordinary in-flow
     section reaches the bottom edge.

     It deliberately overlaps the panel by SKIRT_OVERLAP so a frame of scroll
     lag can never open a seam; the panel's higher z-index keeps the overlap
     invisible. */
  .sticky-cta-skirt {
    position: absolute;
    left: 0;
    right: 0;
    /* Explicit top so it never falls back to its static position — last in the
       body, i.e. past the footer — which would pad the document until the first
       scroll placed it. SiteScripts overwrites this on init. */
    top: 0;
    height: 160px;
    z-index: 89; /* directly beneath the panel */
    display: none;
    visibility: hidden;
    background: var(--color-pure-white);
    pointer-events: none;
    transform: translateY(var(--sticky-slide));
    transition:
      transform 420ms var(--curve-spring),
      visibility 0s linear 420ms;
  }

  @media (max-width: 768px) {
    .sticky-cta { display: block; }
    .sticky-cta-skirt { display: block; }
  }

  .sticky-cta.is-visible,
  .sticky-cta-skirt.is-visible {
    transform: translateY(0);
    visibility: visible;
    transition:
      transform 420ms var(--curve-spring),
      visibility 0s;
  }

  .sticky-cta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
  }

  .sticky-cta :global(.btn-primary) {
    width: 100%;
    max-width: 420px;
    justify-content: center;
  }

  .sticky-cta__note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta,
    .sticky-cta-skirt { transition: visibility 0s; }
  }
</style>
