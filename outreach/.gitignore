# Secrets — NEVER commit
.env
.env.*
!.env.example

# Python
.venv/
# A parallel worktree commonly SYMLINKS .venv to the primary checkout's; `.venv/` matches
# directories only, so without this the symlink shows up as an untracked file to commit.
.venv
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Scratch
*.log
.DS_Store

# operator console runtime logs
ops/logs/
auction_output/
.auction_cache/
