---
/**
 * PreviewFilm — "Your Page, Taking Shape": a silent 15s loop showing an
 * ordinary site being read, its brand lifted, and a branded payment page
 * assembling itself and taking a payment.
 *
 * Ported from the Claude Design composition (project "Your page, taking
 * shape", file `Your Page Taking Shape.dc.html` / `film.jsx`) to a
 * dependency-free DOM island — no React, no design-tool runtime.
 *
 * Structure: 80 BPM, five 3s bars. All motion is a pure function of
 * (bar, beat) where beat = sceneProgress × 4, exactly as the original.
 *
 * Island contract (mirrors DESIGN-SYSTEM §9, adapted for a DOM film):
 *   - The markup below IS the finished render — it ships in the bar-5 "paid"
 *     rest frame. No-JS and prefers-reduced-motion visitors see a complete
 *     picture, never a placeholder or a loading state.
 *   - One rAF, gated by IntersectionObserver; paused when off-screen or when
 *     the tab is hidden. Under reduced motion the loop never starts.
 *   - `data-film-state` = "static" | "live" on the root (testable).
 *
 * The business shown is fictional (Stillwater Weddings) — the hosting section
 * carries the "Illustrative example" disclosure.
 */
---
<!-- Playfair Display carries Stillwater's serif identity inside the film. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;1,500&display=swap"
/>

<div
  class="preview-film"
  data-film-state="static"
  data-preview-film
  role="img"
  aria-label="A sample business website is read, its logo, colours and type are lifted from it, and a branded payment page is built and takes a payment."
>
  <div class="pf-stage" data-pf-stage>
    <!-- ── The ordinary Stillwater site ───────────────────────────── -->
    <div
      class="pf-site"
      data-pf-site
      style="transform:translate(104px,64px) scale(0.82);filter:brightness(0.8) saturate(0.9)"
    >
      <div class="pf-chrome">
        <div class="pf-dots"><span></span><span></span><span></span></div>
        <div class="pf-url" data-pf-url style="background:#FFFFFF">
          <svg class="pf-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          <span>stillwaterweddings.co.uk</span>
        </div>
      </div>
      <div class="pf-site__body">
        <div class="pf-site__mark">
          <svg class="pf-mark" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 23.5c3.8-2.4 7.7-2.4 11.5 0s7.7 2.4 11.5 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M11.5 28c2.8-1.8 5.7-1.8 8.5 0s5.7 1.8 8.5 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
        </div>
        <p class="pf-site__name">Stillwater</p>
        <p class="pf-site__sub">Wedding Photography</p>
        <div class="pf-site__nav">
          <span class="is-on">Home</span><span>Galleries</span><span>Pricing</span><span>Contact</span>
        </div>
        <div class="pf-site__hero">
          <img src="/wedding_photo.jpeg" alt="" loading="lazy" decoding="async" width="1200" height="669" />
        </div>
        <p class="pf-site__tag">Quiet, natural wedding photography — Suffolk &amp; the east coast</p>
        <p class="pf-site__contact">01728 452 917 &nbsp;·&nbsp; hello@stillwaterweddings.co.uk</p>
        <p class="pf-site__foot">Est. 2014 · Suffolk</p>
      </div>
    </div>

    <!-- ── Bar 2: the reading light ───────────────────────────────── -->
    <div class="pf-light" data-pf-light style="opacity:0"></div>

    <!-- ── Bar 2/3: the specimen tray ─────────────────────────────── -->
    <div class="pf-tray" data-pf-tray style="opacity:0">
      <div class="pf-slot" style="top:24px"><i></i><span>Logo</span></div>
      <div class="pf-slot" style="top:108px"><i></i><span>Colours</span></div>
      <div class="pf-slot" style="top:192px"><i></i><span>Type</span></div>
    </div>

    <!-- ── The payment page ───────────────────────────────────────── -->
    <div class="pf-pay" data-pf-pay style="transform:translate(562px,61px) scale(1);opacity:1">
      <div class="pf-chrome pf-chrome--pay">
        <div class="pf-dots"><span></span><span></span><span></span></div>
        <div class="pf-url pf-url--pay">
          <svg class="pf-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          <span>pay.stillwaterweddings.co.uk/booking/SW-1183</span>
        </div>
      </div>

      <div class="pf-mast" data-pf-mast style="background:#26231F">
        <div class="pf-mast__ph" data-pf-mast-ph style="opacity:0">
          <span class="pf-mast__ph-dot"></span><span class="pf-mast__ph-bar"></span>
        </div>
        <div class="pf-mast__brand" data-pf-mast-brand style="opacity:1;transform:scale(1)">
          <div class="pf-mast__mark">
            <svg class="pf-mark" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 23.5c3.8-2.4 7.7-2.4 11.5 0s7.7 2.4 11.5 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M11.5 28c2.8-1.8 5.7-1.8 8.5 0s5.7 1.8 8.5 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
          </div>
          <p class="pf-mast__name">Stillwater</p>
          <p class="pf-mast__sub">Wedding Photography</p>
        </div>
      </div>

      <div class="pf-body" data-pf-body style="background:#FAF7F1;color:#26231F">
        <!-- form face -->
        <div class="pf-form" data-pf-form style="opacity:0">
          <div class="pf-ref">
            <span class="pf-ref__bar" data-pf-refbar style="opacity:0"></span>
            <span class="pf-ref__text" data-pf-reftext style="opacity:1;color:#7D5F2C">Booking Confirmation — SW-1183</span>
          </div>

          <div class="pf-titlerow" data-pf-titlerow style="height:54px">
            <span class="pf-title pf-title--sans" data-pf-title-sans style="opacity:0">Payment details</span>
            <span class="pf-title pf-title--serif" data-pf-title-serif style="opacity:0">Payment details</span>
            <div class="pf-due" data-pf-details style="opacity:1">
              <div>
                <p class="pf-due__label">Balance due</p>
                <p class="pf-due__meta">Grace &amp; Tom · Saturday 3 October 2026</p>
              </div>
              <p class="pf-due__amount">£1,240.00</p>
            </div>
          </div>

          <div class="pf-cardrow">
            <span class="pf-cardrow__label">Pay by Card</span>
            <span class="pf-cardrow__rule"></span>
            <span class="pf-cardrow__marks" data-pf-marks style="opacity:1">
              <img src="/assets/payment/Visa.svg" alt="Visa" />
              <img src="/assets/payment/Mastercard.svg" alt="Mastercard" />
              <img src="/assets/payment/Amex.svg" alt="Amex" />
            </span>
          </div>

          <div class="pf-fields">
            <div class="pf-field">
              <p class="pf-field__label" data-pf-flabel style="color:#7D5F2C">Card Number</p>
              <div class="pf-field__box" data-pf-fbox style="background:#FFFDF9">
                <span class="pf-field__ph" data-pf-fph style="opacity:0">1234 1234 1234 1234</span>
                <span class="pf-field__val" data-pf-fval style="opacity:1;color:#26231F">•••• •••• •••• 4242</span>
              </div>
            </div>
            <div class="pf-fields__pair">
              <div class="pf-field">
                <p class="pf-field__label" data-pf-flabel style="color:#7D5F2C">Expiry Date</p>
                <div class="pf-field__box" data-pf-fbox style="background:#FFFDF9">
                  <span class="pf-field__ph" data-pf-fph style="opacity:0">MM / YY</span>
                  <span class="pf-field__val" data-pf-fval style="opacity:1;color:#26231F">08 / 28</span>
                </div>
              </div>
              <div class="pf-field">
                <p class="pf-field__label" data-pf-flabel style="color:#7D5F2C">Security Code</p>
                <div class="pf-field__box" data-pf-fbox style="background:#FFFDF9">
                  <span class="pf-field__ph" data-pf-fph style="opacity:0">CVC</span>
                  <span class="pf-field__val" data-pf-fval style="opacity:1;color:#26231F">•••</span>
                </div>
              </div>
            </div>
          </div>

          <div class="pf-btn" data-pf-btn style="background:#C8A36A;color:#26231F;transform:translateY(0) scale(1);box-shadow:0 6px 14px rgba(38,35,31,0.18)">
            <span class="pf-btn__face" data-pf-btn-pay style="opacity:0">Pay</span>
            <span class="pf-btn__face" data-pf-btn-amount style="opacity:1">Pay £1,240.00</span>
            <span class="pf-btn__face pf-btn__face--proc" data-pf-btn-proc style="opacity:0">
              <span class="pf-spin" data-pf-spin style="transform:rotate(45deg)"></span>Processing…
            </span>
          </div>

          <p class="pf-fca" data-pf-fca style="color:#6B655C">
            <svg class="pf-lock pf-lock--sm" data-pf-fca-lock style="color:#7D5F2C" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
            <span>Payments secured and processed by an FCA-regulated processor</span>
          </p>
        </div>

        <!-- success face -->
        <div class="pf-done" data-pf-success style="opacity:1">
          <span class="pf-done__tick" data-pf-tickwrap style="transform:scale(1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.75l6 6 9-13.5" stroke-dasharray="30" stroke-dashoffset="0" data-pf-tickpath/></svg>
          </span>
          <h3 class="pf-done__title">Payment Received</h3>
          <p class="pf-done__text">Thank you, Grace &amp; Tom — your balance is settled.</p>
          <div class="pf-receipt">
            <div class="pf-receipt__row"><span>Balance paid</span><span class="pf-receipt__v">£1,240.00</span></div>
            <div class="pf-receipt__row"><span>Booking reference</span><span class="pf-receipt__v">SW-1183</span></div>
          </div>
          <p class="pf-done__note">A receipt has been emailed to you.</p>
          <p class="pf-fca pf-fca--done">
            <svg class="pf-lock pf-lock--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
            <span>Payments secured and processed by an FCA-regulated processor</span>
          </p>
        </div>
      </div>
    </div>

    <!-- ── Flying specimens (bars 2–3) and bar-5 ghosts ───────────── -->
    <div class="pf-spec pf-spec--tile" data-pf-spec="logo" style="opacity:0">
      <svg class="pf-mark pf-mark--spec" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 23.5c3.8-2.4 7.7-2.4 11.5 0s7.7 2.4 11.5 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M11.5 28c2.8-1.8 5.7-1.8 8.5 0s5.7 1.8 8.5 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
    </div>
    <div class="pf-spec pf-spec--sw pf-spec--s0" data-pf-spec="s0" style="opacity:0"></div>
    <div class="pf-spec pf-spec--sw pf-spec--s1" data-pf-spec="s1" style="opacity:0"></div>
    <div class="pf-spec pf-spec--sw pf-spec--s2" data-pf-spec="s2" style="opacity:0"></div>
    <div class="pf-spec pf-spec--tile pf-spec--type" data-pf-spec="type" style="opacity:0">Aa</div>

    <div class="pf-spec pf-spec--tile" data-pf-ghost="logo" style="opacity:0">
      <svg class="pf-mark pf-mark--spec" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 23.5c3.8-2.4 7.7-2.4 11.5 0s7.7 2.4 11.5 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M11.5 28c2.8-1.8 5.7-1.8 8.5 0s5.7 1.8 8.5 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
    </div>
    <div class="pf-spec pf-spec--sw pf-spec--s0" data-pf-ghost="s0" style="opacity:0"></div>
    <div class="pf-spec pf-spec--sw pf-spec--s1" data-pf-ghost="s1" style="opacity:0"></div>
    <div class="pf-spec pf-spec--sw pf-spec--s2" data-pf-ghost="s2" style="opacity:0"></div>
    <div class="pf-spec pf-spec--tile pf-spec--type" data-pf-ghost="type" style="opacity:0">Aa</div>

    <!-- ── Status chip ────────────────────────────────────────────── -->
    <div class="pf-chip" data-pf-chip style="transform:translate(470px,508px);opacity:1">
      <span class="pf-chip__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.75l6 6 9-13.5"/></svg>
      </span>
      <span>Payment received · <b>£1,240.00</b></span>
    </div>

    <!-- ── Cursors ────────────────────────────────────────────────── -->
    <svg class="pf-cursor" data-pf-cursor1 style="opacity:0" viewBox="0 0 24 24"><path d="M5 3 L5 19.2 L9.3 15.5 L12.1 21.8 L14.7 20.6 L11.9 14.5 L17.6 14 Z" fill="#0F172A" stroke="#FFFFFF" stroke-width="1.4" stroke-linejoin="round"/></svg>
    <svg class="pf-cursor" data-pf-cursor2 style="opacity:0" viewBox="0 0 24 24"><path d="M5 3 L5 19.2 L9.3 15.5 L12.1 21.8 L14.7 20.6 L11.9 14.5 L17.6 14 Z" fill="#0F172A" stroke="#FFFFFF" stroke-width="1.4" stroke-linejoin="round"/></svg>

    <!-- ── Caption ────────────────────────────────────────────────── -->
    <p class="pf-cap" data-pf-cap style="opacity:0"></p>
  </div>
</div>

<style>
  .preview-film {
    position: relative;
    aspect-ratio: 1152 / 720;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: radial-gradient(120% 90% at 50% 22%, #1e2b45 0%, #0f172a 62%);
    --pf-hair: rgba(38, 35, 31, 0.14);
    --pf-muted: rgba(38, 35, 31, 0.62);
    --pf-serif: 'Playfair Display', Georgia, serif;
    --pf-sans: 'Avenir Next', 'Helvetica Neue', Helvetica, system-ui, sans-serif;
  }
  /* Fixed 1152×720 design space, scaled to the container. The default matches
     the panel's natural column width so a no-JS render still lands correctly;
     the script sets the exact factor and keeps it right on resize. */
  .pf-stage {
    position: absolute;
    inset: 0;
    width: 1152px;
    height: 720px;
    transform-origin: 0 0;
    transform: scale(var(--pf-scale, 0.48));
    font-family: 'Satoshi', system-ui, sans-serif;
  }

  /* ── shared chrome ── */
  .pf-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: #f8fafc;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }
  .pf-chrome--pay { padding: 9px 14px; }
  .pf-dots { display: flex; gap: 6px; }
  .pf-dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(15, 23, 42, 0.14); }
  .pf-url {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    max-width: 230px;
    margin: 0 auto;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(15, 23, 42, 0.5);
  }
  .pf-url--pay { max-width: 250px; font-size: 11px; background: #fff; white-space: nowrap; }
  .pf-lock { width: 11px; height: 11px; flex: none; color: #10b981; }
  .pf-lock--sm { width: 10px; height: 10px; }
  .pf-mark { width: 32px; height: 32px; display: block; color: #c8a36a; }

  /* ── the ordinary site ── */
  .pf-site {
    position: absolute;
    top: 0;
    left: 0;
    width: 600px;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: 0 1px 3px rgba(30, 58, 138, 0.05), 0 18px 50px rgba(30, 58, 138, 0.12);
  }
  .pf-site__body {
    background: #faf7f1;
    color: #26231f;
    font-family: var(--pf-sans);
    padding: 32px 44px 26px;
    text-align: center;
  }
  .pf-site__mark { display: grid; justify-items: center; }
  .pf-site__name {
    margin: 8px 0 0;
    font-family: var(--pf-serif);
    font-size: 25px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .pf-site__sub {
    margin: 7px 0 0;
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: #7d5f2c;
  }
  .pf-site__nav {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 18px;
    padding: 9px 0;
    border-top: 1px solid var(--pf-hair);
    border-bottom: 1px solid var(--pf-hair);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pf-muted);
  }
  .pf-site__nav .is-on { color: #7d5f2c; border-bottom: 1px solid #c8a36a; padding-bottom: 2px; }
  .pf-site__hero {
    margin-top: 20px;
    height: 178px;
    position: relative;
    border: 1px solid var(--pf-hair);
    border-radius: 4px;
    overflow: hidden;
    background: #f2ecdf;
  }
  .pf-site__hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pf-site__tag {
    margin: 18px 0 0;
    font-family: var(--pf-serif);
    font-style: italic;
    font-size: 16.5px;
    font-weight: 500;
  }
  .pf-site__contact { margin: 10px 0 0; font-size: 11.5px; color: var(--pf-muted); }
  .pf-site__foot {
    margin: 16px 0 0;
    padding-top: 10px;
    border-top: 3px double var(--pf-hair);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(38, 35, 31, 0.4);
  }

  /* ── reading light ── */
  .pf-light {
    position: absolute;
    top: 0;
    left: 0;
    width: 660px;
    height: 160px;
    z-index: 10;
    filter: blur(3px);
    background: linear-gradient(
      180deg,
      rgba(59, 130, 246, 0) 0%,
      rgba(59, 130, 246, 0.26) 38%,
      rgba(147, 197, 253, 0.5) 50%,
      rgba(59, 130, 246, 0.26) 62%,
      rgba(59, 130, 246, 0) 100%
    );
  }

  /* ── specimen tray ── */
  .pf-tray {
    position: absolute;
    top: 0;
    left: 0;
    width: 190px;
    height: 312px;
    background: #fff;
    border-radius: 12px;
    border: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: 0 1px 3px rgba(30, 58, 138, 0.05), 0 18px 50px rgba(30, 58, 138, 0.12);
  }
  .pf-slot { position: absolute; left: 16px; width: 158px; height: 68px; }
  .pf-slot i { position: absolute; inset: 0; border: 1.5px dashed rgba(15, 23, 42, 0.16); border-radius: 8px; }
  .pf-slot span {
    position: absolute;
    left: 8px;
    top: -7px;
    padding: 0 5px;
    background: #fff;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(15, 23, 42, 0.45);
  }

  /* ── specimens ── */
  .pf-spec { position: absolute; top: 0; left: 0; z-index: 30; }
  .pf-spec--tile {
    width: 62px;
    height: 62px;
    background: #fff;
    border-radius: 8px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.22);
    display: grid;
    place-items: center;
  }
  .pf-spec--type { font-family: var(--pf-serif); font-size: 24px; color: #26231f; }
  .pf-mark--spec { width: 32px; height: 32px; }
  .pf-spec--sw { width: 26px; height: 26px; border-radius: 50%; box-shadow: 0 8px 18px rgba(2, 6, 23, 0.25); }
  .pf-spec--s0 { background: #26231f; border: 1px solid rgba(255, 255, 255, 0.35); }
  .pf-spec--s1 { background: #c8a36a; border: 1px solid rgba(255, 255, 255, 0.35); }
  .pf-spec--s2 { background: #faf7f1; border: 1px solid rgba(38, 35, 31, 0.2); }

  /* ── payment window ── */
  .pf-pay {
    position: absolute;
    top: 0;
    left: 0;
    width: 436px;
    transform-origin: 50% 40%;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
