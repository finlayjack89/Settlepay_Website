    color: rgba(226, 232, 240, 0.55);
  }
</style>

<script>
  /* "Your Page, Taking Shape" — 15s loop at 80 BPM, five 3s bars.
     Every value is a pure function of (bar, beat); ported verbatim from the
     Claude Design composition so the motion matches the approved film. */
  const root = document.querySelector<HTMLElement>('[data-preview-film]');
  if (root) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const $$ = (sel: string) => Array.from(root.querySelectorAll(sel)) as HTMLElement[];

    /* ── math ── */
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const EIO = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);
    const EOUT = (p: number) => 1 - Math.pow(1 - p, 3);
    const EIN = (p: number) => p * p * p;
    const SPRING = (p: number) => (p >= 1 ? 1 : p <= 0 ? 0 : 1 - Math.exp(-6 * p) * Math.cos(9.5 * p));
    const SPRING_SOFT = (p: number) => (p >= 1 ? 1 : p <= 0 ? 0 : 1 - Math.exp(-5 * p) * Math.cos(6 * p));
    const ev = (b: number, t0: number, t1: number, fn?: (q: number) => number) =>
      (fn || EIO)(clamp01((b - t0) / (t1 - t0)));
    const lin = (q: number) => q;
    const hx = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const mix = (a: string, b: string, t: number) => {
      const A = hx(a), B = hx(b);
      return `rgb(${Math.round(lerp(A[0], B[0], t))},${Math.round(lerp(A[1], B[1], t))},${Math.round(lerp(A[2], B[2], t))})`;
    };
    const arc = (a: any, b: any, p: number, h: number) => ({
      x: lerp(a.x, b.x, EIO(p)),
      y: lerp(a.y, b.y, EIO(p)) - Math.sin(Math.PI * p) * h,
    });

    /* ── layout constants ── */
    const SITE = { x: 210, y: 58 };
    const SITE_BACK = { x: 104, y: 64, s: 0.82 };
    const TRAY2 = { x: 850, y: 186 };
    const TRAY3 = { x: 100, y: 200 };
    const WIN = { x: 562, y: 66 };
    const BTN = { x: 780, y: 470 };
    const CHIP = { x: 470, y: 508 };
    const URLPT = { x: 512, y: 86 };
    const SRC: any = { logo: { x: 510, y: 178 }, s0: { x: 476, y: 184 }, s1: { x: 543, y: 208 }, s2: { x: 510, y: 336 }, type: { x: 510, y: 492 } };
    const SLOT: any = { logo: { x: 95, y: 58 }, s0: { x: 57, y: 142 }, s1: { x: 95, y: 142 }, s2: { x: 133, y: 142 }, type: { x: 95, y: 226 } };
    const TGT: any = { logo: { x: 780, y: 147 }, s0: { x: 764, y: 470 }, s1: { x: 780, y: 470 }, s2: { x: 796, y: 470 }, type: { x: 648, y: 240 } };
    const FL2: any = { logo: [0.7, 1.15], s0: [1.2, 1.6], s1: [1.5, 1.9], s2: [1.8, 2.2], type: [2.2, 2.65] };
    const FL3: any = { logo: [0.85, 1.3], s0: [1.75, 2.1], s1: [1.87, 2.22], s2: [1.99, 2.34], type: [2.4, 2.75] };
    const KEYS = ['logo', 's0', 's1', 's2', 'type'];

    /* ── refs ── */
    const stage = $('[data-pf-stage]');
    const site = $('[data-pf-site]'), url = $('[data-pf-url]'), light = $('[data-pf-light]');
    const tray = $('[data-pf-tray]'), pay = $('[data-pf-pay]');
    const mast = $('[data-pf-mast]'), mastPh = $('[data-pf-mast-ph]'), mastBrand = $('[data-pf-mast-brand]');
    const body = $('[data-pf-body]'), form = $('[data-pf-form]');
    const refbar = $('[data-pf-refbar]'), reftext = $('[data-pf-reftext]');
    const titlerow = $('[data-pf-titlerow]'), tSans = $('[data-pf-title-sans]'), tSerif = $('[data-pf-title-serif]');
    const details = $('[data-pf-details]'), marks = $('[data-pf-marks]');
    const fLabels = $$('[data-pf-flabel]'), fBoxes = $$('[data-pf-fbox]'), fPhs = $$('[data-pf-fph]'), fVals = $$('[data-pf-fval]');
    const btn = $('[data-pf-btn]'), btnPay = $('[data-pf-btn-pay]'), btnAmt = $('[data-pf-btn-amount]');
    const btnProc = $('[data-pf-btn-proc]'), spin = $('[data-pf-spin]');
    const fca = $('[data-pf-fca]'), fcaLock = $('[data-pf-fca-lock]');
    const success = $('[data-pf-success]'), tickWrap = $('[data-pf-tickwrap]'), tickPath = $('[data-pf-tickpath]');
    const chip = $('[data-pf-chip]'), cur1 = $('[data-pf-cursor1]'), cur2 = $('[data-pf-cursor2]'), cap = $('[data-pf-cap]');
    const specs: any = {}, ghosts: any = {};
    KEYS.forEach((k) => {
      specs[k] = $(`[data-pf-spec="${k}"]`);
      ghosts[k] = $(`[data-pf-ghost="${k}"]`);
    });

    const put = (el: HTMLElement, x: number, y: number, o: number, extra?: string) => {
      el.style.opacity = String(o);
      el.style.transform = `translate(${x}px,${y}px)${extra || ''}`;
    };
    const centre = (el: HTMLElement, st: any) => {
      if (!st) { el.style.opacity = '0'; return; }
      el.style.opacity = String(st.o);
      el.style.transform = `translate(calc(${st.x}px - 50%),calc(${st.y}px - 50%)) scale(${st.s})`;
    };

    /* ── specimen state (bars 2–3) ── */
    function specState(bar: number, beat: number, key: string, tr: any) {
      const src = SRC[key], tgt = TGT[key];
      const slot = tr ? { x: tr.x + SLOT[key].x, y: tr.y + SLOT[key].y } : null;
      if (bar === 2 && slot) {
        const f = FL2[key];
        if (beat < f[0]) return null;
        if (beat < f[1]) {
          const p = ev(beat, f[0], f[1], lin);
          const pos = arc(src, slot, p, 54);
          return { x: pos.x, y: pos.y, o: Math.min(1, p * 3), s: 0.7 + 0.3 * p };
        }
        const q = clamp01((beat - f[1]) / 0.5);
        return { x: slot.x, y: slot.y, o: 1, s: 1 + 0.12 * Math.exp(-5 * q) * Math.cos(9 * q) * (q > 0 ? 1 : 0) };
      }
      if (bar === 3 && slot) {
        const f = FL3[key];
        if (beat < f[0]) return { x: slot.x, y: slot.y, o: tr.o, s: 1 };
        if (beat < f[1]) {
          const p = ev(beat, f[0], f[1], lin);
          const pos = arc(slot, tgt, p, 64);
          return { x: pos.x, y: pos.y, o: 1, s: 1 - 0.15 * p };
        }
        const fade = 1 - ev(beat, f[1], f[1] + 0.18);
        return fade <= 0 ? null : { x: tgt.x, y: tgt.y, o: fade, s: 0.85 };
      }
      return null;
    }

    /* ── one frame ── */
    function render(bar: number, beat: number, lt: number) {
      /* site window */
      let sx = SITE.x, sy = SITE.y, ss = 1, dim = 0;
      if (bar === 3) {
        const p = ev(beat, 0.05, 0.85);
        sx = lerp(SITE.x, SITE_BACK.x, p); sy = lerp(SITE.y, SITE_BACK.y, p);
        ss = lerp(1, SITE_BACK.s, p); dim = p;
      } else if (bar === 4) {
        sx = SITE_BACK.x; sy = SITE_BACK.y; ss = SITE_BACK.s; dim = 1;
      } else if (bar === 5) {
        const p = SPRING_SOFT(ev(beat, 2.6, 3.6, lin));
        sx = lerp(SITE_BACK.x, SITE.x, p); sy = lerp(SITE_BACK.y, SITE.y, p);
        ss = lerp(SITE_BACK.s, 1, p); dim = 1 - p;
      }
      site.style.transform = `translate(${sx}px,${sy}px) scale(${ss})`;
      site.style.filter = `brightness(${1 - 0.2 * dim}) saturate(${1 - 0.1 * dim})`;

      /* url focus glow */
      const glow = bar === 1 ? ev(beat, 2.0, 2.35) : bar === 2 ? 1 - ev(beat, 0.1, 0.6) : 0;
      url.style.background = mix('#FFFFFF', '#F1F5F9', glow * 0.6);
      url.style.boxShadow = glow ? `0 0 0 3px rgba(15,23,42,${0.1 * glow})` : 'none';

      /* cursor 1 — arrives and clicks the url bar */
      if (bar === 1) {
        const p = ev(beat, 0.5, 2.0);
        const press = Math.sin(clamp01((beat - 2.0) / 0.25) * Math.PI);
        put(cur1, lerp(1010, URLPT.x, p), lerp(700, URLPT.y, p), ev(beat, 0.5, 0.8), ` scale(${1 - 0.1 * press})`);
      } else if (bar === 2) {
        const o = 1 - ev(beat, 0.15, 0.6);
        if (o > 0) put(cur1, URLPT.x, URLPT.y + 8 * (1 - o), o);
        else cur1.style.opacity = '0';
      } else cur1.style.opacity = '0';

      /* bar-2 reading light */
      if (bar === 2) {
        const p = ev(beat, 0, 1.6);
        const o = Math.min(ev(beat, 0, 0.25), 1 - ev(beat, 1.35, 1.65));
        if (o > 0) put(light, 180, lerp(SITE.y - 40, SITE.y + 560, p) - 80, o);
        else light.style.opacity = '0';
      } else light.style.opacity = '0';

      /* tray */
      let tr: any = null;
      if (bar === 2) {
        const p = ev(beat, 0.55, 0.95);
        if (p > 0) tr = { x: TRAY2.x, y: TRAY2.y, o: p, rise: (1 - p) * 14 };
      } else if (bar === 3) {
        const m = ev(beat, 0.1, 0.8);
        const o = 1 - ev(beat, 3.1, 3.7);
        if (o > 0) tr = { x: lerp(TRAY2.x, TRAY3.x, m), y: lerp(TRAY2.y, TRAY3.y, m), o, rise: 0 };
      }
      if (tr) put(tray, tr.x, tr.y + tr.rise, tr.o);
      else tray.style.opacity = '0';

      /* payment window */
      if (bar >= 3) {
        let wx = WIN.x, wy = WIN.y, wo = 1, wsc = 1;
        if (bar === 3) { const p = SPRING(clamp01(beat / 0.85)); wx = lerp(1240, WIN.x, p); wo = beat <= 0 ? 0 : 1; }
        if (bar === 4) wy = WIN.y - 5 * ev(beat, 2.05, 2.6);
        if (bar === 5) {
          wy = WIN.y - 5;
          const q = ev(beat, 2.3, 3.1);
          wx = WIN.x + 90 * EIN(q); wsc = 1 - 0.04 * q; wo = 1 - ev(beat, 2.45, 3.05);
        }
        put(pay, wx, wy, wo, ` scale(${wsc})`);

        const logoPop = bar > 3 ? 1 : SPRING(clamp01((beat - FL3.logo[1]) / 0.5));
        const colorIn = bar > 3 ? 1 : ev(beat, 2.1, 2.7);
        const typeIn = bar > 3 ? 1 : ev(beat, 2.7, 3.05);
        const detailsIn = bar > 3 ? 1 : ev(beat, 3.0, 3.6);
        const cardIn = bar > 3 ? 1 : ev(beat, 3.35, 3.85);
        const proc = bar === 4 ? ev(beat, 0.22, 0.38) * (1 - ev(beat, 1.95, 2.15)) : 0;
        const successIn = bar === 4 ? ev(beat, 2.05, 2.6) : bar === 5 ? 1 : 0;
        const tick = bar === 4 ? ev(beat, 2.15, 2.8) : bar === 5 ? 1 : 0;
        const dip = bar === 4 ? Math.sin(clamp01(beat / 0.3) * Math.PI) : 0;

        const inkCol = mix('#475569', '#26231F', colorIn);
        const labelCol = mix('#94A3B8', '#7D5F2C', colorIn);

        mast.style.background = mix('#E7EBF0', '#26231F', colorIn);
        mastPh.style.opacity = String(1 - Math.min(1, logoPop * 2));
        mastBrand.style.opacity = String(Math.min(1, logoPop * 1.4));
        mastBrand.style.transform = `scale(${0.8 + 0.2 * logoPop})`;

        body.style.background = mix('#F3F5F7', '#FAF7F1', colorIn);
        body.style.color = inkCol;
        form.style.opacity = String(1 - successIn);

        refbar.style.opacity = String(1 - detailsIn);
        reftext.style.opacity = String(detailsIn);
        reftext.style.color = labelCol;

        titlerow.style.height = `${lerp(26, 54, detailsIn)}px`;
        tSans.style.opacity = String((1 - typeIn) * (1 - detailsIn));
        tSerif.style.opacity = String(typeIn * (1 - detailsIn));
        details.style.opacity = String(detailsIn);
        marks.style.opacity = String(detailsIn);

        const fieldBg = mix('#FFFFFF', '#FFFDF9', colorIn);
        fLabels.forEach((el) => (el.style.color = labelCol));
        fBoxes.forEach((el) => (el.style.background = fieldBg));
        fPhs.forEach((el) => (el.style.opacity = String(1 - cardIn)));
        fVals.forEach((el) => { el.style.opacity = String(cardIn); el.style.color = inkCol; });

        btn.style.background = mix('#CBD5E1', '#C8A36A', colorIn);
        btn.style.color = inkCol;
        btn.style.transform = `translateY(${dip * 1.5}px) scale(${1 - 0.02 * dip})`;
        btn.style.boxShadow = `0 ${lerp(6, 2, dip)}px ${lerp(14, 6, dip)}px rgba(38,35,31,${0.18 * colorIn})`;
        btnPay.style.opacity = String((1 - detailsIn) * (1 - proc));
        btnAmt.style.opacity = String(detailsIn * (1 - proc));
        btnProc.style.opacity = String(proc);
        spin.style.transform = `rotate(${(lt * 540) % 360}deg)`;

        fca.style.color = mix('#94A3B8', '#6B655C', colorIn);
        fcaLock.style.color = labelCol;

        success.style.opacity = String(successIn);
        tickWrap.style.transform = `scale(${0.6 + 0.4 * SPRING(successIn)})`;
        tickPath.setAttribute('stroke-dashoffset', String(30 * (1 - tick)));
      } else {
        pay.style.opacity = '0';
      }

      /* cursor 2 — the customer */
      if (bar === 3 && beat > 3.2) {
        const p = ev(beat, 3.25, 3.95);
        put(cur2, lerp(1130, BTN.x + 2, p), lerp(740, BTN.y, p), ev(beat, 3.25, 3.5));
      } else if (bar === 4) {
        const o = 1 - ev(beat, 0.7, 1.5);
        if (o > 0) {
          const press = Math.sin(clamp01(beat / 0.3) * Math.PI);
          put(cur2, BTN.x + 2 + 60 * ev(beat, 0.7, 1.7), BTN.y + 80 * ev(beat, 0.7, 1.7), o, ` scale(${1 - 0.1 * press})`);
        } else cur2.style.opacity = '0';
      } else cur2.style.opacity = '0';

      /* chip */
      if (bar === 4 && beat > 2.95) {
        const p = SPRING(ev(beat, 3.0, 3.55, lin));
        put(chip, CHIP.x, CHIP.y + 26 * (1 - p), ev(beat, 3.0, 3.2));
      } else if (bar === 5) {
        const q = ev(beat, 2.0, 2.35);
        if (q < 1) put(chip, CHIP.x, CHIP.y + 18 * q, 1 - q);
        else chip.style.opacity = '0';
      } else chip.style.opacity = '0';

      /* bar-5 ghosts — the brand lifting away, vocabulary reversed */
      KEYS.forEach((k, i) => {
        let st: any = null;
        if (bar === 5) {
          const q = ev(beat, 2.05 + i * 0.09, 2.6 + i * 0.09);
          if (q > 0 && q < 1) st = { x: TGT[k].x, y: TGT[k].y - 64 * EOUT(q), o: Math.min(q * 6, 1) * (1 - q), s: 0.7 };
        }
        centre(ghosts[k], st);
      });

      /* specimens */
      const trSpec = bar === 2 || bar === 3 ? tr || (bar === 3 ? { x: TRAY2.x, y: TRAY2.y, o: 1 } : null) : null;
      KEYS.forEach((k) => centre(specs[k], specState(bar, beat, k, trSpec)));

      /* caption */
      const text = bar === 1 ? 'Reading your site…' : bar === 2 ? 'Capturing your homepage and brand…' : bar === 3 ? 'Applying your colours, logo and type…' : '';
      if (cap.textContent !== text) cap.textContent = text;
      cap.style.opacity = text ? String(ev(beat, 0.5, 1.0) * (1 - ev(beat, 3.4, 3.9))) : '0';
    }

    const frameAt = (t: number) => {
      const idx = Math.min(4, Math.floor(t / 3));
      const lt = t - idx * 3;
      render(idx + 1, (lt / 3) * 4, lt);
    };

    /* ── scale the fixed design space to the container ── */
    const fit = () => stage.style.setProperty('--pf-scale', String(root.clientWidth / 1152));
    fit();
    if ('ResizeObserver' in window) new ResizeObserver(fit).observe(root);
    else window.addEventListener('resize', fit);

    /* ── the loop: IO-gated, reduced-motion safe ── */
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0, start = 0, inView = false;

    const tick = (now: number) => {
      if (!start) start = now;
      frameAt(((now - start) / 1000) % 15);
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0; start = 0;
      root.setAttribute('data-film-state', 'static');
    };
    const sync = () => {
      const go = inView && document.visibilityState === 'visible' && !reduce.matches;
      if (go && !raf) {
        root.setAttribute('data-film-state', 'live');
        raf = requestAnimationFrame(tick);
      } else if (!go && raf) {
        stop();
        frameAt(12.75); // back to the finished "paid" rest frame
      }
    };

    new IntersectionObserver(
      (entries) => { for (const e of entries) inView = e.isIntersecting; sync(); },
      { threshold: 0.35 }
    ).observe(root);
    document.addEventListener('visibilitychange', sync);
    if (reduce.addEventListener) reduce.addEventListener('change', sync);
  }
</script>
